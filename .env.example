APP_NAME=ai-sales-customer-automation
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

POSTGRES_DB=sales_automation
POSTGRES_USER=sales_app
POSTGRES_PASSWORD=change_me_for_local_development
# psycopg accepts postgresql:// (not SQLAlchemy's postgresql+psycopg://)
DATABASE_URL=postgresql://sales_app:change_me_for_local_development@db:5432/sales_automation

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Comma-separated mapping: Telegram numeric user ID=tenant UUID
TELEGRAM_OPERATOR_TENANTS=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Telegram webhook shared secret (set a long random value outside source control)
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated mappings: Telegram channel numeric ID=tenant UUID
TELEGRAM_CATALOG_TENANTS=
